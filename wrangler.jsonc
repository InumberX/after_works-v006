{
  // Cloudflare Workers configuration for the OpenNext build of the Next.js app.
  // Docs: https://opennext.js.org/cloudflare  |  https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "after-works",
  // Custom Worker entrypoint that wraps the OpenNext handler with Basic auth.
  // It imports the generated `.open-next/worker.js` produced by the build.
  "main": "workers/app.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Disable the *.workers.dev subdomain in all environments so the site is only
  // reachable via custom domains/routes (never the default workers.dev URL).
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets",
    // Production has no Basic auth, so matching static files are served from
    // the edge without invoking the Worker. With Smart Placement the Worker may
    // run far from the visitor, and routing assets through it would slow them
    // down. Staging turns this on in `env.development`.
    "run_worker_first": false,
  },
  "observability": {
    "enabled": true,
  },
  // Environment-specific names. Build-time NEXT_PUBLIC_* values are injected by
  // the GitHub Actions workflow; runtime secrets (BASIC_AUTH_*) are set per
  // environment with `wrangler secret put ... --env=<environment>`.
  //
  // Smart Placement runs the Worker near the Kuroco API rather than near each
  // visitor. Run from every data center, the Worker spread its requests over
  // Kuroco's CDN and most of them missed its cache.
  //
  // An environment's `assets` replaces the top level's whole, so staging
  // repeats `binding` and `directory`.
  "env": {
    "development": {
      "name": "dev-after-works",
      "placement": { "mode": "smart" },
      "assets": {
        "binding": "ASSETS",
        "directory": ".open-next/assets",
        // Run the Worker first so the Basic auth gate also covers static
        // assets. Authenticated GET/HEAD requests are then served from ASSETS
        // by the custom Worker before falling through to the Next.js handler.
        "run_worker_first": true,
      },
    },
    "production": {
      "name": "after-works",
      "placement": { "mode": "smart" },
    },
  },
}
